# =============================================================================
# Environment variables template.
# Copy this file to ".env" and fill in real values locally.
# NEVER commit the real ".env" file — it is excluded via .gitignore.
# =============================================================================

# --- Application ---
APP_NAME=tg-ig-bridge
APP_ENV=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=tg_ig_bridge
POSTGRES_SSL_MODE=require

# Connection pool tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# =============================================================================
# Production settings
# =============================================================================

# --- Telegram ---
# Ingestion is MANUAL: forward (or send directly) a photo/video + text to
# the dashboard bot below, and pick POST/REEL/STORY from its buttons — see
# app/telegram/manual_capture.py. No api_id/api_hash/session needed.
TELEGRAM_SESSION_NAME=tg_ig_bridge

# --- Instagram Publisher ---
# Official Meta Graph API only. Create a long-lived access token for a
# Business/Creator Instagram account linked to a Facebook Page, per
# Meta's Graph API documentation.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_API_BASE_URL=https://graph.facebook.com/v23.0
INSTAGRAM_REQUEST_TIMEOUT_SECONDS=30

INSTAGRAM_CONTAINER_POLL_INTERVAL_SECONDS=2
INSTAGRAM_CONTAINER_POLL_MAX_ATTEMPTS=15

INSTAGRAM_MAX_PUBLISH_ATTEMPTS=5
INSTAGRAM_RETRY_BASE_DELAY_SECONDS=30
INSTAGRAM_RETRY_MAX_DELAY_SECONDS=3600

# Public base URL media files are served from (the Graph API needs a
# public HTTPS URL, not a local path) — leave empty to make publishing
# fail loudly with a clear config error instead of guessing.
# When MEDIA_STORAGE_BACKEND=s3, set this to the same value as
# MEDIA_PUBLIC_BASE_URL below.
INSTAGRAM_MEDIA_BASE_URL=

# REVIEW (default): nothing auto-publishes, everything waits for a human/
# Phase-9 approval action. AUTO: eligible due items publish automatically.
INSTAGRAM_PUBLISH_MODE=REVIEW

# --- AI Provider (Groq, OpenAI-compatible Chat Completions) ---
# Get an API key from https://console.groq.com/keys
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_API_BASE_URL=https://api.groq.com/openai/v1
AI_API_VERSION=
AI_REQUEST_TIMEOUT_SECONDS=30

# How many candidate captions to generate per product (some may be
# rejected by validation and are simply not selected).
AI_CAPTION_CANDIDATES=3
AI_CAPTION_MAX_TOKENS=600

# Instagram's hard caption length limit.
AI_MAX_CAPTION_LENGTH=2200
AI_MIN_CAPTION_LENGTH=10

# --- Scoring + Queue + Scheduler ---
# IANA timezone the scheduler uses for "what day/time is it" decisions
# (daily_limits lookups, scheduled_for slot assignment). Uses the stdlib
# zoneinfo module, no extra dependency required.
SCHEDULER_TIMEZONE=Asia/Gaza

# Content type the batch scheduler queues by default (POST/REEL/STORY).
SCHEDULER_DEFAULT_CONTENT_TYPE=POST

# Phase 9 Telegram Dashboard
TELEGRAM_BOT_TOKEN=
TELEGRAM_DASHBOARD_ADMIN_IDS=

# --- Persistent media storage ---
# For GitHub Actions use 's3' (works with Supabase Storage, Cloudflare R2,
# AWS S3, etc.). For local development you can use 'local'.
# Recommended: Supabase Storage — it's part of the same free Supabase
# account already used for the database, and needs no credit card.
#   MEDIA_S3_ENDPOINT_URL = https://<project_ref>.storage.supabase.co/storage/v1/s3
#   MEDIA_S3_REGION       = the region shown on the Storage > S3 settings page
#   MEDIA_PUBLIC_BASE_URL = https://<project_ref>.supabase.co/storage/v1/object/public/<bucket_name>
MEDIA_STORAGE_BACKEND=s3
MEDIA_STORAGE_DIR=/tmp/tg-ig-media
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_BUCKET_NAME=
MEDIA_PUBLIC_BASE_URL=

# --- Daily defaults ---
DEFAULT_DAILY_POST_LIMIT=1
DEFAULT_DAILY_REEL_LIMIT=1
DEFAULT_DAILY_STORY_LIMIT=10
STORY_COOLDOWN_HOURS=24

# After a product finishes (published/rejected/duplicate/skipped/failed),
# delete its media files and captions after this many days to save
# storage. The product_code + channel are kept forever regardless (see
# app/media/retention.py). Set to 0 to disable purging entirely.
MEDIA_RETENTION_DAYS=5

# Long-running local compatibility worker; GitHub Actions uses run_once instead.
WORKER_INTERVAL_SECONDS=900
